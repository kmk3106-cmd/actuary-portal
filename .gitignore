# 로그
bot/logs/
bot/data/bot.log
server.log
server.err
server/cloudflare.log
server/*.log
server/data/server-*.txt
server/data/*.log

# DB 백업 스냅샷 (개인정보·해시 포함)
server/data/backup/

# 임시 점검·디버그 산출물 (규칙 3: tmp/_check_NN_*.py 등은 추적하지 않음)
tmp/
tmp_*.txt
tmp_*.json

# 디자인 참고 캡처/스크린샷
capture/

# Python 캐시
__pycache__/
*.py[cod]
*.pyo

# 임시 Office 잠금 파일
~$*

# Excel 데이터 파일 (개인정보 포함)
*.xlsx

# 사용자 데이터 스냅샷
users_new.json

# Node 모듈
node_modules/

# Claude 세션 파일 (CLAUDE.md / settings 는 유지)
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/settings.local.json
