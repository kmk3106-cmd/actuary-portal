# 빌드 컨텍스트 축소 (이미지에 안 들어가도 되는 것들)
# 단, docker-compose 는 소스를 바인드마운트하므로 .dockerignore 는 이미지 빌드 단계에만 영향.

.git
.gitignore
.gitattributes
node_modules

# Claude / IDE 작업물
.claude
.vscode
.idea

# 데이터 백업·로그 (이미지에 포함될 필요 없음, 마운트로 들어옴)
server/data/backup
server/data/*.log
server/data/*.txt
bot/logs
bot/__pycache__
*.log
logs

# 빌드/스크린샷/실험물
capture
tmp
tmp_*.txt
*.png
*.jpg

# 환경
*.local
.env.local

# 도커 자산 자체는 컨텍스트 외(자기참조 방지)
Dockerfile.server
Dockerfile.bot
docker-compose.yml
.dockerignore
