# 계리결산팀 포탈 - 환경변수 템플릿
# 실제 사용 시 이 파일을 .env 로 복사해서 값 채워넣기
#   cp .env.example .env
#   nano .env
# .env 는 절대 git 에 커밋 금지 (.gitignore 에 등록됨)

# ─── 서버 (Node.js) ────────────────────────────────
NODE_ENV=production
PORT=8888
HOST=0.0.0.0

# 로그인 비밀번호 해싱용 시드 (server.js 참고)
# 아직 하드코딩된 'password' 를 그대로 사용한다면 비워둬도 됨

# ─── 텔레그램 봇 ──────────────────────────────────
# BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# 봇 사용 허용 텔레그램 user ID (쉼표 구분)
ALLOWED_USER_IDS=

# 기본 기준 연월 (YYYYMM)
DEFAULT_PERIOD=202609
CURRENT_PERIODS=202609

# 봇에서 조회할 포탈 URL (docker compose 내부 네트워크)
PORTAL_URL=http://server:8888

# ─── Cloudflare Tunnel ────────────────────────────
# Zero Trust 대시보드 > Networks > Tunnels 에서 새 터널 생성 후 발급받은 토큰
# https://one.dash.cloudflare.com/  →  Access → Tunnels → Create a tunnel
# "Docker" 탭에서 표시되는 --token 뒤의 문자열 그대로 복사
CLOUDFLARE_TUNNEL_TOKEN=

# ─── 데이터 경로 (컨테이너 내부, 보통 수정 안 함) ──
DB_PATH=/app/server/data/actuarial.db
LOG_DIR=/app/bot/logs
HEARTBEAT_PATH=/app/server/data/bot-heartbeat.json
